{
  "start_node": "greeting_1",
  "nodes": {
    "greeting_1": {
      "npc_text": "（舔了舔嘴唇）一个人类小哥……闻起来，味道还不错的样子。你是新来的祭品吗？",
      "player_options": [
        {
          "text": "在下是合欢宗新弟子，不是祭品。",
          "next_node": "response_correct"
        },
        {
          "text": "如果公主想“吃”我，我也不是不能考虑。",
          "next_node": "response_flirt",
          "affinity_change": 10
        },
        {
          "text": "妖孽，休得胡言！",
          "next_node": "response_angry",
          "affinity_change": -10
        }
      ]
    },
    "response_correct": {
      "npc_text": "哦？弟子？真无趣。我还以为能换换口味呢。",
      "player_options": [
        {
          "text": "……",
          "next_node": "end"
        }
      ]
    },
    "response_flirt": {
      "npc_text": "咯咯咯……真是有趣的小哥。我记住你了，希望你不要让我失望哦。",
      "player_options": [
        {
          "text": "随时恭候公主殿下。",
          "next_node": "end"
        }
      ]
    },
    "response_angry": {
      "npc_text": "（眼神变冷）你们人类，就是这么无趣又傲慢。滚吧。",
      "player_options": [
        {
          "text": "（看来她不喜欢这个称呼）",
          "next_node": "end"
        }
      ]
    },
    "end": {
      "npc_text": null,
      "end_dialogue": true
    }
  }
}
