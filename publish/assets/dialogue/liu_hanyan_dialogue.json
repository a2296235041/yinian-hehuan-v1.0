{
  "start_node": "greeting_1",
  "nodes": {
    "greeting_1": {
      "npc_text": "你就是新来的弟子？抬起头来，让本座看看。",
      "player_options": [
        {
          "text": "（恭敬地）弟子拜见宗主。",
          "next_node": "response_respectful",
          "affinity_change": 5
        },
        {
          "text": "（直视她）宗主风华绝代，弟子心向往之。",
          "next_node": "response_bold",
          "affinity_change": -5
        },
        {
          "text": "（保持沉默）",
          "next_node": "end"
        }
      ]
    },
    "response_respectful": {
      "npc_text": "嗯，还算懂规矩。记住，在合欢宗，实力与忠诚才是一切。下去吧。",
      "player_options": [
        {
          "text": "是，宗主。",
          "next_node": "end"
        }
      ]
    },
    "response_bold": {
      "npc_text": "哼，胆子不小。希望你的实力能配得上你的胆量。别让本座失望。",
      "player_options": [
        {
          "text": "弟子定不负宗主厚望。",
          "next_node": "end"
        }
      ]
    },
    "end": {
      "npc_text": null,
      "end_dialogue": true
    }
  }
}
