{
  "start_node": "greeting_1",
  "nodes": {
    "greeting_1": {
      "npc_text": "这位师弟，瞧着眼生得很，是新来的吗？我是你的接引师姐苏媚儿，以后有什么不懂的，都可以来问我哦。",
      "player_options": [
        {
          "text": "（谦逊地）师姐好，我确实是新来的，以后还请多多指教。",
          "next_node": "response_polite",
          "affinity_change": 5
        },
        {
          "text": "（油嘴滑舌地）早就听闻师姐艳名，今日一见，果然名不虚传。",
          "next_node": "response_flirty",
          "affinity_change": -5
        },
        {
          "text": "（冷淡地）嗯。",
          "next_node": "response_cold"
        }
      ]
    },
    "response_polite": {
      "npc_text": "师弟真是谦虚有礼，我很喜欢。我们合欢宗随心所欲，不必太过拘谨。你刚来，先去熟悉一下环境吧。",
      "player_options": [
        {
          "text": "多谢师姐提醒。",
          "next_node": "end"
        }
      ]
    },
    "response_flirty": {
      "npc_text": "呵呵，师弟嘴还挺甜。不过这种话，我听得多了，可不是光靠嘴皮子就能讨师姐欢心的哦。",
      "player_options": [
        {
          "text": "（尴尬地）是在下唐突了。",
          "next_node": "end"
        }
      ]
    },
    "response_cold": {
      "npc_text": "……看来是个性子冷的师弟呢。也好，我们宗门什么样的人都有。你自己去转转吧。",
      "player_options": [
        {
          "text": "（点头）",
          "next_node": "end"
        }
      ]
    },
    "end": {
      "npc_text": null,
      "end_dialogue": true
    }
  }
}
