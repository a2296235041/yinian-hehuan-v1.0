{
  "start_node": "greeting_1",
  "nodes": {
    "greeting_1": {
      "npc_text": "（打哈欠）又一个来寻找力量的……这里的书，你看得懂多少？",
      "player_options": [
        {
          "text": "弟子愚钝，还望阁主指点一二。",
          "next_node": "response_humble",
          "affinity_change": 5
        },
        {
          "text": "书是死的，人是活的。我更想了解阁主您。",
          "next_node": "response_curious",
          "affinity_change": 0
        },
        {
          "text": "（自行翻阅书籍）",
          "next_node": "end"
        }
      ]
    },
    "response_humble": {
      "npc_text": "哦？难得有这么谦虚的。也好，去那边看看吧，从最基础的吐纳心法开始，别好高骛远。",
      "player_options": [
        {
          "text": "多谢阁主。",
          "next_node": "end"
        }
      ]
    },
    "response_curious": {
      "npc_text": "（嘴角微微上扬）我可比这些死书无趣多了。去看你的书吧，小家伙。",
      "player_options": [
        {
          "text": "……是。",
          "next_node": "end"
        }
      ]
    },
    "end": {
      "npc_text": null,
      "end_dialogue": true
    }
  }
}
