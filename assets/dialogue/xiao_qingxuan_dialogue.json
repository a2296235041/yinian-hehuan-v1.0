{
  "start_node": "greeting_1",
  "nodes": {
    "greeting_1": {
      "npc_text": "这位师弟，请留步。我看你气息纯正，不似……不似寻常同门。你为何会选择加入合欢宗？",
      "player_options": [
        {
          "text": "追求至高的力量，何处不是修行？",
          "next_node": "response_power"
        },
        {
          "text": "因为这里的师姐们都很美。",
          "next_node": "response_lust",
          "affinity_change": -5
        },
        {
          "text": "这是我的私事，与你无关。",
          "next_node": "response_private"
        }
      ]
    },
    "response_power": {
      "npc_text": "（眼神复杂）力量……是啊，力量……但若为了力量不择手段，与魔头何异？希望师弟能坚守本心。",
      "player_options": [
        {
          "text": "多谢师姐教诲。",
          "next_node": "end"
        }
      ]
    },
    "response_lust": {
      "npc_text": "（眉头紧锁）肤浅！你……你们果然都是一路货色！",
      "player_options": [
        {
          "text": "（她似乎很生气）",
          "next_node": "end"
        }
      ]
    },
    "response_private": {
      "npc_text": "……是我唐突了。师弟请便。",
      "player_options": [
        {
          "text": "（她似乎在隐藏什么）",
          "next_node": "end"
        }
      ]
    },
    "end": {
      "npc_text": null,
      "end_dialogue": true
    }
  }
}
